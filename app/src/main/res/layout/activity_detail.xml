<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main_dark"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/img_detail_cover"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:background="@drawable/bg_image_placeholder"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_image_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Title"
            android:textColor="@color/text_title_white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_detail_views"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Views: 0"
            android:textColor="@color/text_content_grey"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_detail_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="6dp"
            android:text="Detailed content goes here..."
            android:textColor="@color/text_content_grey"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>