<?xml version="1.0" encoding="utf-8"?>
<!-- 1. ScrollView trở thành thẻ gốc, bọc toàn bộ màn hình -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main_dark"
    android:fillViewport="true"> <!-- fillViewport giúp nội dung giãn vừa màn hình nếu quá ngắn -->

    <!-- 2. Thẻ con duy nhất của ScrollView chứa toàn bộ cấu trúc cũ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Ảnh bìa -->
        <ImageView
            android:id="@+id/img_detail_cover"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_image_placeholder" />

        <!-- Khối chứa nội dung chữ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_title_white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_detail_views"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_content_grey"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- TextView chứa bài viết dài -->
            <TextView
                android:id="@+id/tv_detail_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/text_content_grey"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>